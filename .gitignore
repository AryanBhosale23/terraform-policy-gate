# Terraform: never commit state, provider downloads or saved plans
.terraform/
*.tfstate
*.tfstate.*
crash.log
tfplan
*.tfplan
# A plan can contain real values from a real stack. Plans are made fresh (locally and in CI), never stored.
plan.json
# Secrets and AWS config: never commit these
.env
.env.*
*.pem
*.key
.aws/
credentials
# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
# Real gate output stays local. Only reviewed samples go in examples/
evidence/
